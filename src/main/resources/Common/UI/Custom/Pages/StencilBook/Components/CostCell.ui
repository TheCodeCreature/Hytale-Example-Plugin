// Shared cost cell — icon frame with quantity badge
// Appended into per-row containers: #CostGrid[row] #CostRowCells
// Java selectors: #CostGrid[row] #CostRowCells[col] #Icon/#Qty/#Dim

$CP = "../../../Common/Components/Components.ui";
$L = "../../../Styles/Labels.ui";
$BG = "../../../Styles/Backgrounds.ui";

Group {
    Anchor: (Width: 60, Height: 60);
    Visible: false;
    Padding: (Left: 4, Right: 4, Bottom: 4);

    $CP.@ItemIconCell {
        @Background = $BG.@OutputSlotFrame;
    }

    Label #Qty {
        Text: "";
        Anchor: (Height: 14, Bottom: 0, Right: 2);
        Style: $L.@CostQuantityStyle;
    }
}