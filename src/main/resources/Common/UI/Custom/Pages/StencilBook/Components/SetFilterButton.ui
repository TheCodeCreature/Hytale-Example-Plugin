// SetFilterButton — single set filter toggle button
// Reusable component: server appends N instances into #SetFilters during build()
// Server updates via cmd.set() on indexed selectors: #SetFilters[N].Visible, #Btn.Text, #Btn.Style, #Check.Value

$C = "../../../Common.ui";
$B = "../../../Styles/Buttons.ui";
$BG = "../../../Styles/Backgrounds.ui";
$L = "../../../Styles/Labels.ui";

Group {
    Anchor: (Height: 24);
    Visible: false;

    TextButton #Btn {
        Text: "";
        Anchor: (Full: 0);
        Padding: (Left: 22, Right: 24);
    }

    CheckBox #Check {
        Anchor: (Width: 16, Height: 16, Left: 4, Top: 4);
        Background: (TexturePath: "../../../Common/CheckBoxFrame.png", Border: 7);
        Padding: (Full: 2);
        Style: $C.@DefaultCheckBoxStyle;
    }

    Group {
        Anchor: (Width: 18, Height: 18, Right: 3, Top: 3);

        Label #IgnoreIconCross {
            Text: "x";
            Anchor: (Full: 0);
            Style: $L.@SectionLabelStyle;
            Visible: true;
        }

        Group #IgnoreIconCheck {
            Anchor: (Full: 1);
            Background: $BG.@CheckIcon;
            Visible: false;
        }

        TextButton #IgnoreBtn {
            Text: "";
            Anchor: (Full: 0);
            Style: $B.@InvisibleHitTargetButtonStyle;
        }
    }
}