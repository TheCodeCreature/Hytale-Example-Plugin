// SetGroupContainer — per-set group with label header and wrapping cell grid
// Server appends CELLS_PER_GROUP RecipeIconCell.ui instances into #GroupCells during build()
// Server shows/hides the entire group and sets #SetGroupLabel.Text via cmd.set()
//
// Addressing pattern:
//   Group root  → #RecipeGridArea[g]
//   Label       → #RecipeGridArea[g] #SetGroupLabel
//   Cell grid   → #RecipeGridArea[g] #GroupCells
//   Cell i      → #RecipeGridArea[g] #GroupCells[i]
//   Cell button → #RecipeGridArea[g] #GroupCells[i] #CellBtn

$L = "../../../Styles/Labels.ui";
$C = "../../../Common.ui";

Group {
    LayoutMode: Top;
    Anchor: (Full: 8);
    Visible: false;

    Group {
        LayoutMode: Top;
        Background: $C.@TertiaryDefaultButtonBackground;
        Padding: (Left: 4, Right: 4, Top: 4, Bottom: 12);

        Label #SetGroupLabel {
            Text: "";
            Style: $L.@SetGroupLabelStyle;
            Anchor: (Height: 24, Left: 0, Right: 0);
            Padding: (Left: 4, Top: 10, Bottom: 10);
        }

        Group #GroupCells {
            LayoutMode: LeftCenterWrap;
        }
    }
}