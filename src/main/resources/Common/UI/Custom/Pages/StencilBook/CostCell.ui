// Cost cell — single ingredient icon with quantity overlay
// Reusable component: server appends N instances into #CostGrid during build()
// Server updates via cmd.set() on indexed selectors: #CostGrid[N] #CostIcon, #CostGrid[N] #CostQty, #CostGrid[N] #CostDim

$L = "../../Styles/Labels.ui";
$BG = "../../Styles/Backgrounds.ui";

Group {
    Anchor: (Width: 60, Height: 60);
    Visible: false;
    Padding: (Full: 4);

    Group {
        Background: $BG.@ItemSlotFrame;
        ItemIcon #CostIcon {
            Anchor: (Full: 2);
            ShowItemTooltip: true;
        }
        Group #CostDim {
            Anchor: (Full: 2);
            Background: $BG.@DimOverlay;
            Visible: false;
        }
    }

    Label #CostQty {
        Text: "";
        Anchor: (Height: 14, Bottom: 0, Right: 2);
        Style: $L.@CostQuantityStyle;
    }
}
