// Temporary sandbox page for Stencil Crafting layout experimentation.
// Loaded via StencilSelectionPage when USE_STENCIL_SANDBOX_UI is true.
// This file is intentionally static and uses hardcoded sample icon groups.

$C = "../../Common.ui";
$B = "../../Styles/Buttons.ui";
$L = "../../Styles/Labels.ui";
$BG = "../../Styles/Backgrounds.ui";

Group {
    Anchor: (Width: 1480, Height: 720);
    LayoutMode: Top;

    TabNavigation {
        Style: $C.@TopTabsStyle;
        SelectedTab: "All";
        Anchor: (Height: 66, Left: 2, Right: 0);

        TabButton {
            Icon: "../../Common/RecipesIcon.png";
            TooltipText: "Stencil Sandbox";
            Id: "All";
            Visible: true;
        }
    }

    $C.@Container {
        @ContentPadding = (Left: 0, Right: 0, Top: 10, Bottom: 0);
        Anchor: (Height: 644, Left: 0, Right: 0);

        Group {
            LayoutMode: Left;
            Anchor: (Left: 0, Right: 0, Top: 0, Height: 34);

            $C.@Title { @Text = "Stencil Crafting Sandbox:"; }
            Label {
                Text: "Static Icon Grid Sample";
                Style: $L.@SubheaderStyle;
                Anchor: (Left: 0, Top: 4);
            }
        }

        Group {
            LayoutMode: Left;
            Anchor: (Left: 0, Right: 0, Top: 44, Bottom: 0);
            Padding: (Left: 8, Right: 8, Bottom: 8);

            Group {
                Anchor: (Width: 210);
                LayoutMode: Top;
                Padding: (Right: 8);

                Label {
                    Text: "Sandbox Notes";
                    Style: $L.@SectionLabelStyle;
                    Anchor: (Height: 28);
                }

                Label {
                    Text: "Use this static layout to prototype a dynamic grid-in-grid view.";
                    Style: $L.@SubtextStyle;
                    Anchor: (Height: 80);
                }

                Label {
                    Text: "No runtime filtering is wired on this page.";
                    Style: $L.@SubtextStyle;
                    Anchor: (Height: 26);
                }
            }

            Group { Anchor: (Width: 1); Background: $BG.@DividerColor; }

            Group {
                FlexWeight: 1;
                LayoutMode: TopScrolling;
                ScrollbarStyle: $C.@DefaultScrollbarStyle;
                Padding: (Left: 8, Right: 8);

                Group {
                    LayoutMode: Top;
                    Anchor: (Left: 0, Right: 0);

                    Group {
                        LayoutMode: Top;
                        Anchor: (Left: 0, Right: 0);
                        Padding: (Left: 4, Right: 4, Top: 4, Bottom: 10);
                        Background: $C.@TertiaryDefaultButtonBackground;

                        Label {
                            Text: "Deco Iron";
                            Style: $L.@SetGroupLabelStyle;
                            Anchor: (Height: 24, Left: 0, Right: 0);
                            Padding: (Left: 4, Top: 8, Bottom: 8);
                        }

                        Group {
                            LayoutMode: LeftCenterWrap;
                            Anchor: (Left: 0, Right: 0);

                            Group { Anchor: (Width: 72, Height: 72); Background: $BG.@ItemSlotFrame; Group { Anchor: (Full: 10); Background: "../../Common/Icons/ItemsGenerated/Bench_WorkBench.png"; } TextButton { Text: ""; Anchor: (Full: 2); Style: $B.@TransparentButtonStyle; } }
                            Group { Anchor: (Width: 72, Height: 72); Background: $BG.@ItemSlotFrame; Group { Anchor: (Full: 10); Background: "../../Common/Icons/ItemsGenerated/Bench_Armory.png"; } TextButton { Text: ""; Anchor: (Full: 2); Style: $B.@TransparentButtonStyle; } }
                            Group { Anchor: (Width: 72, Height: 72); Background: $BG.@ItemSlotFrame; Group { Anchor: (Full: 10); Background: "../../Common/Icons/ItemsGenerated/Bench_WorkBench.png"; } TextButton { Text: ""; Anchor: (Full: 2); Style: $B.@TransparentButtonStyle; } }
                            Group { Anchor: (Width: 72, Height: 72); Background: $BG.@ItemSlotFrame; Group { Anchor: (Full: 10); Background: "../../Common/Icons/ItemsGenerated/Bench_Armory.png"; } TextButton { Text: ""; Anchor: (Full: 2); Style: $B.@TransparentButtonStyle; } }
                            Group { Anchor: (Width: 72, Height: 72); Background: $BG.@ItemSlotFrame; Group { Anchor: (Full: 10); Background: "../../Common/Icons/ItemsGenerated/Bench_WorkBench.png"; } TextButton { Text: ""; Anchor: (Full: 2); Style: $B.@TransparentButtonStyle; } }
                            Group { Anchor: (Width: 72, Height: 72); Background: $BG.@ItemSlotFrame; Group { Anchor: (Full: 10); Background: "../../Common/Icons/ItemsGenerated/Bench_Armory.png"; } TextButton { Text: ""; Anchor: (Full: 2); Style: $B.@TransparentButtonStyle; } }
                        }
                    }

                    Group { Anchor: (Height: 8); }

                    Group {
                        LayoutMode: Top;
                        Anchor: (Left: 0, Right: 0);
                        Padding: (Left: 4, Right: 4, Top: 4, Bottom: 10);
                        Background: $C.@TertiaryDefaultButtonBackground;

                        Label {
                            Text: "Furniture Adventure";
                            Style: $L.@SetGroupLabelStyle;
                            Anchor: (Height: 24, Left: 0, Right: 0);
                            Padding: (Left: 4, Top: 8, Bottom: 8);
                        }

                        Group {
                            LayoutMode: LeftCenterWrap;
                            Anchor: (Left: 0, Right: 0);

                            Group { Anchor: (Width: 72, Height: 72); Background: $BG.@ItemSlotFrame; Group { Anchor: (Full: 10); Background: "../../Common/Icons/ItemsGenerated/Bench_Armory.png"; } TextButton { Text: ""; Anchor: (Full: 2); Style: $B.@TransparentButtonStyle; } }
                            Group { Anchor: (Width: 72, Height: 72); Background: $BG.@ItemSlotFrame; Group { Anchor: (Full: 10); Background: "../../Common/Icons/ItemsGenerated/Bench_WorkBench.png"; } TextButton { Text: ""; Anchor: (Full: 2); Style: $B.@TransparentButtonStyle; } }
                            Group { Anchor: (Width: 72, Height: 72); Background: $BG.@ItemSlotFrame; Group { Anchor: (Full: 10); Background: "../../Common/Icons/ItemsGenerated/Bench_Armory.png"; } TextButton { Text: ""; Anchor: (Full: 2); Style: $B.@TransparentButtonStyle; } }
                            Group { Anchor: (Width: 72, Height: 72); Background: $BG.@ItemSlotFrame; Group { Anchor: (Full: 10); Background: "../../Common/Icons/ItemsGenerated/Bench_WorkBench.png"; } TextButton { Text: ""; Anchor: (Full: 2); Style: $B.@TransparentButtonStyle; } }
                            Group { Anchor: (Width: 72, Height: 72); Background: $BG.@ItemSlotFrame; Group { Anchor: (Full: 10); Background: "../../Common/Icons/ItemsGenerated/Bench_Armory.png"; } TextButton { Text: ""; Anchor: (Full: 2); Style: $B.@TransparentButtonStyle; } }
                            Group { Anchor: (Width: 72, Height: 72); Background: $BG.@ItemSlotFrame; Group { Anchor: (Full: 10); Background: "../../Common/Icons/ItemsGenerated/Bench_WorkBench.png"; } TextButton { Text: ""; Anchor: (Full: 2); Style: $B.@TransparentButtonStyle; } }
                            Group { Anchor: (Width: 72, Height: 72); Background: $BG.@ItemSlotFrame; Group { Anchor: (Full: 10); Background: "../../Common/Icons/ItemsGenerated/Bench_Armory.png"; } TextButton { Text: ""; Anchor: (Full: 2); Style: $B.@TransparentButtonStyle; } }
                            Group { Anchor: (Width: 72, Height: 72); Background: $BG.@ItemSlotFrame; Group { Anchor: (Full: 10); Background: "../../Common/Icons/ItemsGenerated/Bench_WorkBench.png"; } TextButton { Text: ""; Anchor: (Full: 2); Style: $B.@TransparentButtonStyle; } }
                        }
                    }

                    Group { Anchor: (Height: 8); }

                    Group {
                        LayoutMode: Top;
                        Anchor: (Left: 0, Right: 0);
                        Padding: (Left: 4, Right: 4, Top: 4, Bottom: 10);
                        Background: $C.@TertiaryDefaultButtonBackground;

                        Label {
                            Text: "Furniture Castle";
                            Style: $L.@SetGroupLabelStyle;
                            Anchor: (Height: 24, Left: 0, Right: 0);
                            Padding: (Left: 4, Top: 8, Bottom: 8);
                        }

                        Group {
                            LayoutMode: LeftCenterWrap;
                            Anchor: (Left: 0, Right: 0);

                            Group { Anchor: (Width: 72, Height: 72); Background: $BG.@ItemSlotFrame; Group { Anchor: (Full: 10); Background: "../../Common/Icons/ItemsGenerated/Bench_WorkBench.png"; } TextButton { Text: ""; Anchor: (Full: 2); Style: $B.@TransparentButtonStyle; } }
                            Group { Anchor: (Width: 72, Height: 72); Background: $BG.@ItemSlotFrame; Group { Anchor: (Full: 10); Background: "../../Common/Icons/ItemsGenerated/Bench_Armory.png"; } TextButton { Text: ""; Anchor: (Full: 2); Style: $B.@TransparentButtonStyle; } }
                            Group { Anchor: (Width: 72, Height: 72); Background: $BG.@ItemSlotFrame; Group { Anchor: (Full: 10); Background: "../../Common/Icons/ItemsGenerated/Bench_WorkBench.png"; } TextButton { Text: ""; Anchor: (Full: 2); Style: $B.@TransparentButtonStyle; } }
                            Group { Anchor: (Width: 72, Height: 72); Background: $BG.@ItemSlotFrame; Group { Anchor: (Full: 10); Background: "../../Common/Icons/ItemsGenerated/Bench_Armory.png"; } TextButton { Text: ""; Anchor: (Full: 2); Style: $B.@TransparentButtonStyle; } }
                        }
                    }
                }
            }

            Group { Anchor: (Width: 1); Background: $BG.@DividerColor; }

            Group {
                Anchor: (Width: 300);
                LayoutMode: Top;
                Padding: (Left: 10);

                Label {
                    Text: "Sandbox Detail";
                    Style: $L.@DetailLabelStyle;
                }

                Group { Anchor: (Height: 8); }

                Group {
                    Anchor: (Width: 96, Height: 96);
                    Background: $BG.@OutputSlotFrame;

                    Group {
                        Anchor: (Full: 10);
                        Background: "../../Common/Icons/ItemsGenerated/Bench_WorkBench.png";
                    }
                }

                Group { Anchor: (Height: 12); }

                Label {
                    Text: "Static placeholder side panel for quick layout testing.";
                    Style: $L.@SubtextStyle;
                    Anchor: (Height: 60);
                }
            }
        }
    }
}
