// Production recipe grid row container.
// Hosts grouped set containers using sandbox-style row packing under #RowGroups.

Group {
    LayoutMode: Top;
    Anchor: (Left: 0, Right: 0);
    Padding: (Left: 2, Right: 2, Top: 2, Bottom: 2);
    Visible: false;

    Group #RowGroups {
        LayoutMode: LeftCenterWrap;
        Anchor: (Left: 0, Right: 0);
        Padding: (Left: 2, Right: 2, Top: 2, Bottom: 2);
    }
}
