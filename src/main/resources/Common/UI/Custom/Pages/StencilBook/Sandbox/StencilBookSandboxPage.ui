// Temporary sandbox page for Stencil Crafting layout experimentation.
// Loaded via feature-flagged sandbox page route.
// This file is intentionally static and uses hardcoded sample icon groups.

$C = "../../../Common.ui";
$Tabs = "Templates/Layout/SandboxTopTabs.ui";
$Title = "Templates/Layout/SandboxTitleBar.ui";
$Row = "Templates/Layout/ContentRow.ui";
$Left = "Templates/Layout/LeftPanel.ui";
$Divider = "Templates/Layout/VerticalDivider.ui";
$Center = "Templates/Layout/CenterScrollPanel.ui";
$Right = "Templates/Layout/RightPanel.ui";

Group {
    Anchor: (Width: 1480, Height: 720);
    LayoutMode: Top;

    $Tabs.@SandboxTopTabs { @TabIcon = "../../../../../Common/RecipesIcon.png"; }

    $C.@Container {
        @ContentPadding = (Left: 0, Right: 0, Top: 10, Bottom: 0);
        Anchor: (Height: 644, Left: 0, Right: 0);

        #Title {
            $Title.@SandboxTitleBar {}
        }

        #Content {
            $Row.@ContentRow {

                $Left.@LeftPanel {
                    Group #NotesHost {
                        LayoutMode: Top;
                        Anchor: (Left: 0, Right: 0);
                    }
                }

                $Divider.@VerticalDivider {}

                $Center.@CenterScrollPanel {
                    Group #SetGroups {
                        LayoutMode: Top;
                        Anchor: (Left: 0, Right: 0);
                    }
                }

                $Divider.@VerticalDivider {}

                $Right.@RightPanel {
                    Group #DetailHost {
                        LayoutMode: Top;
                        Anchor: (Left: 0, Right: 0);
                    }
                }
            }
        }
    }
}
