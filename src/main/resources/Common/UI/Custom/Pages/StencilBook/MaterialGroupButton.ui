// MaterialGroupButton — material group icon button for filter bar

$B = "../../Styles/Buttons.ui";
$BG = "../../Styles/Backgrounds.ui";

Group {
    Anchor: (Width: 30, Height: 30);
    Padding: (Left: 1, Right: 1, Top: 1, Bottom: 1);
    Visible: false;
    Background: $BG.@CategoryCellBg;

    ItemIcon #GroupIcon {
        Anchor: (Full: 3);
        Visible: false;
    }

    TextButton #GroupBtn {
        Text: "";
        Anchor: (Full: 0);
        Style: $B.@TransparentButtonStyle;
    }
}
