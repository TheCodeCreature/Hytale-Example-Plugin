// Test page: ItemGrid with slot drag events (Option A)

$C = "../../Common.ui";

@StatusStyle = LabelStyle(
    ...$C.@DefaultLabelStyle,
    FontSize: 14, TextColor: #3aff5c,
    HorizontalAlignment: Center, VerticalAlignment: Center
);

Group {
    Anchor: (Width: 600, Height: 500);
    LayoutMode: Top;

    $C.@Container {

    #Title {
        $C.@Title {
            @Text = "ItemGrid Drag Test";
        }
    }

    #Content {

    // Status label — shows last event
    Label #StatusLabel {
        Text: "Click Populate to fill grid, then try dragging slots";
        Anchor: (Height: 24);
        Style: @StatusStyle;
    }

    Group { Anchor: (Height: 4); }

    // Event log
    Label #EventLog {
        Text: "";
        Anchor: (Height: 80);
        Style: @StatusStyle;
    }

    Group { Anchor: (Height: 1); Background: #333333; }
    Group { Anchor: (Height: 8); }

    // Match StencilBookPage CostGrid structure exactly:
    // Parent Group with Width + LayoutMode: Top, grid with FlexWeight: 1
    Group {
        Anchor: (Width: 240);
        LayoutMode: Top;

        ItemGrid #SourceGrid {
            FlexWeight: 1;
            SlotsPerRow: 4;
            DisplayItemQuantity: true;
            RenderItemQualityBackground: false;
            Style: (SlotSize: 48, SlotIconSize: 48, SlotSpacing: 4);
        }
    }

    Group { Anchor: (Height: 8); }
    Group { Anchor: (Height: 1); Background: #333333; }
    Group { Anchor: (Height: 8); }

    // Input slot label
    Label #InputLabel {
        Text: "Drop Target";
        Anchor: (Height: 20);
        Style: @StatusStyle;
    }

    Group { Anchor: (Height: 4); }

    // Single input slot — drop target for drag testing
    Group {
        Anchor: (Width: 240);
        LayoutMode: Top;

        ItemGrid #InputGrid {
            FlexWeight: 1;
            SlotsPerRow: 1;
            DisplayItemQuantity: true;
            RenderItemQualityBackground: false;
            Style: (SlotSize: 48, SlotIconSize: 48, SlotSpacing: 4);
        }
    }

    } // #Content
    } // $C.@Container
} // Page Root
