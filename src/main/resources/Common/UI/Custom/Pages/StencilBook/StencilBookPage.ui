// Stencil Crafting — main page layout
// Server appends reusable .ui components (SetFilterButton, CostCell, ResourceTypeFilterButton) during build()
// Server updates via cmd.set() only in handleDataEvent() — no append/clear after build()

$C = "../../Common.ui";
$B = "../../Styles/Buttons.ui";
$L = "../../Styles/Labels.ui";
$BG = "../../Styles/Backgrounds.ui";

// ── Page Root ──

Group {
    Anchor: (Width: 1480, Height: 720);
    LayoutMode: Top;

    // Bench tabs above the container
    TabNavigation #BenchTabs {
        Style: $C.@TopTabsStyle;
        SelectedTab: "All";
        Anchor: (Height: 66, Left: 2, Right: 0);

        TabButton { Icon: "../../Common/RecipesIcon.png"; TooltipText: ""; Id: ""; Visible: false; }
        TabButton { Icon: "../../Common/RecipesIcon.png"; TooltipText: ""; Id: ""; Visible: false; }
        TabButton { Icon: "../../Common/RecipesIcon.png"; TooltipText: ""; Id: ""; Visible: false; }
        TabButton { Icon: "../../Common/RecipesIcon.png"; TooltipText: ""; Id: ""; Visible: false; }
        TabButton { Icon: "../../Common/RecipesIcon.png"; TooltipText: ""; Id: ""; Visible: false; }
        TabButton { Icon: "../../Common/RecipesIcon.png"; TooltipText: ""; Id: ""; Visible: false; }
        TabButton { Icon: "../../Common/RecipesIcon.png"; TooltipText: ""; Id: ""; Visible: false; }
        TabButton { Icon: "../../Common/RecipesIcon.png"; TooltipText: ""; Id: ""; Visible: false; }
        TabButton { Icon: "../../Common/RecipesIcon.png"; TooltipText: ""; Id: ""; Visible: false; }
        TabButton { Icon: "../../Common/RecipesIcon.png"; TooltipText: ""; Id: ""; Visible: false; }
        TabButton { Icon: "../../Common/RecipesIcon.png"; TooltipText: ""; Id: ""; Visible: false; }
        TabButton { Icon: "../../Common/RecipesIcon.png"; TooltipText: ""; Id: ""; Visible: false; }
        TabButton { Icon: "../../Common/RecipesIcon.png"; TooltipText: ""; Id: ""; Visible: false; }
        TabButton { Icon: "../../Common/RecipesIcon.png"; TooltipText: ""; Id: ""; Visible: false; }
        TabButton { Icon: "../../Common/RecipesIcon.png"; TooltipText: ""; Id: ""; Visible: false; }
        TabButton { Icon: "../../Common/RecipesIcon.png"; TooltipText: ""; Id: ""; Visible: false; }
    }

    // Main container
    $C.@Container {
        @ContentPadding = (Left: 0, Right: 0, Top: 10, Bottom: 0);
        Anchor: (Height: 644, Left: 0, Right: 0);

        #Title {
            Group {
                LayoutMode: Left;
                Anchor: (Full: 0);

                $C.@Title {
                    @Text = "Stencil Crafting:";
                }

                Label #ActiveBenchLabel {
                    FlexWeight: 1;
                    Anchor: (Left: 0, Top: 4);
                    Text: "All";
                    Style: $L.@SubheaderStyle;
                    MaskTexturePath: $C.@TextHighlightGradientMask;
                }



                $C.@HeaderSearch {}
            }
        }

        #Content {

        // Three-column layout
        Group {
            FlexWeight: 1;
            LayoutMode: Left;
            Padding: (Left: 8, Right: 8, Bottom: 8);

        // ══════════════════════════════
        // LEFT COLUMN — Recipe browser
        // ══════════════════════════════
        Group {
            FlexWeight: 1;
            LayoutMode: Top;
            Padding: (Right: 12);

            // Content area: set filters on left, recipe grid on right
            Group {
                FlexWeight: 1;
                LayoutMode: Left;

                Group {
                    LayoutMode: Top;
                    // Set filter sidebar — single scrollable column
                    Group {
                        Anchor: (Width: 164);
                        LayoutMode: Top;
                        ScrollbarStyle: $C.@DefaultScrollbarStyle;
                        FlexWeight: 1;

                        // Category group icon buttons — collapsible section
                        Group {
                            Anchor: (Height: 24, Left: 0, Right: 0);

                            TextButton #CategoriesHeader {
                                Text: "v Categories";
                                Anchor: (Full: 0);
                                Padding: (Left: 6, Right: 22);
                                Style: $B.@SectionHeaderStyle;
                            }

                            Group {
                                Anchor: (Width: 24, Height: 24, Right: 2);
                                Background: $BG.@TrashIcon;

                                TextButton #ClearCategoriesBtn {
                                    Text: "";
                                    Anchor: (Full: 0);
                                }
                            }
                        }

                        Group {
                            Anchor: (Height: 100);
                            LayoutMode: TopScrolling;
                            ScrollbarStyle: $C.@DefaultScrollbarStyle;

                            Group #MaterialGroups {
                                LayoutMode: LeftCenterWrap;
                            }
                        }

                        Group { Anchor: (Height: 6); }

                        // Set filter buttons — collapsible section
                        Group {
                            Anchor: (Height: 30, Left: 0, Right: 0);

                            TextButton #SetsHeader {
                                Text: "v Sets";
                                Anchor: (Full: 0);
                                Padding: (Left: 6, Right: 22);
                                Style: $B.@SectionHeaderStyle;
                            }

                            Group {
                                Anchor: (Width: 24, Height: 24, Right: 2);
                                Background: $BG.@TrashIcon;

                                TextButton #ClearSetsBtn {
                                    Text: "";
                                    Anchor: (Full: 0);
                                }
                            }
                        }

                        Group #SetFilters {
                            FlexWeight: 1;
                            LayoutMode: TopScrolling;
                            ScrollbarStyle: $C.@DefaultScrollbarStyle;
                        }
                    }
                }

                // Vertical divider between filters and grid
                Group { Anchor: (Width: 1); Background: $BG.@DividerColor; }

        // ══════════════════════════════
        // CENTER COLUMN — Recipe browser
        // ══════════════════════════════

                // Scrollable recipe item grid
                Group {
                    FlexWeight: 1;
                    LayoutMode: TopScrolling;
                    ScrollbarStyle: $C.@DefaultScrollbarStyle;
                    Padding: (Left: 8);

                    Group #RecipeGridArea {
                        LayoutMode: Top;
                        Anchor: (Left: 0, Right: 0);
                    }
                }
            }
        }

        // Vertical divider
        Group { Anchor: (Width: 1); Background: $BG.@DividerColor; }

        // ══════════════════════════════
        // RIGHT COLUMN — Recipe Details
        // ══════════════════════════════
        Group {
            Anchor: (Width: 310);
            LayoutMode: Top;
            Padding: (Left: 12);

            // ── Output Name ──
            Label #OutputName {
                Text: "No recipe selected";
                Style: $L.@DetailLabelStyle;
            }

            Group { Anchor: (Height: 10); }

            // ── Output Icon + Cost Grid ──
            Group {
                Anchor: (Height: 170);
                LayoutMode: Left;

                Group {
                    LayoutMode: Top;
                    Group #OutputFrame {
                        Anchor: (Height: 96, Width: 96, Top: 0);
                        Background: $BG.@OutputSlotFrame;

                        ItemIcon #OutputIcon {
                            Anchor: (Full: 4);
                            ShowItemTooltip: true;
                        }

                        Group #OutputDim {
                            Anchor: (Full: 2);
                            Background: $BG.@DimOverlay;
                            Visible: false;
                        }
                    }

                    // ── Give Stencil Button ──
                    Group #GetPlaceholderBtnFrame {
                        Anchor: (Height: 40, Width: 96, Right: 0, Left: 0, Top: 10);
                        Background: #000000(0.0);

                        TextButton #GetPlaceholderBtn {
                            Text: "Give Stencil";
                            Anchor: (Full: 1);
                            Padding: (Left: 12, Right: 12);
                            Style: $B.@WrapPrimaryButtonStyle;
                        }
                    }

                    Group { Anchor: (Height: 6); }

                    Label #GiveStencilStatusLabel {
                        Text: "";
                        Anchor: (Height: 16, Left: 0, Right: 0);
                        Style: $L.@PageIndicatorLabelStyle;
                        Visible: false;
                    }
                }

                Group { Anchor: (Width: 4); }

                // ── Ingredient cost grid viewport (scrolling) ──
                Group {
                    Anchor: (Top: 0, Bottom: 0);
                    FlexWeight: 1;
                    LayoutMode: TopScrolling;
                    ScrollbarStyle: $C.@DefaultScrollbarStyle;
                    Padding: (Right: 2);

                    Group #CostGrid {
                        LayoutMode: Top;
                        Anchor: (Top: 0, Left: 0, Right: 0);
                    }
                }
            }

            Group { Anchor: (Height: 8); }
            $C.@PanelSeparatorFancy {}
            Group { Anchor: (Height: 8); }

            // ── Ingredient Filter Section Header ──
            // Filter toggles
            Group {
                Anchor: (Height: 26, Left: 0, Right: 8);
                LayoutMode: Left;

                Label {
                    Text: "Resource Filter Options";
                    Style: $L.@SectionLabelStyle;
                    FlexWeight: 1;
                    Padding: (Left: 6);
                }

                TextButton #AffordableToggle {
                    Text: "Inventory Driven";
                    Anchor: (Height: 24);
                    Padding: (Left: 6, Right: 6);
                }
            }
            
            Group #IngredientSection {
                LayoutMode: Top;
                FlexWeight: 1;

                Group { Anchor: (Height: 8); }
                $C.@PanelSeparatorFancy {}
                Group { Anchor: (Height: 8); }

                Group {
                    Anchor: (Height: 26, Left: 0, Right: 0);
                    LayoutMode: Left;

                    Label {
                        Text: "INGREDIENTS";
                        Style: $L.@SectionLabelStyle;
                        FlexWeight: 1;
                        Padding: (Left: 6);
                    }

                    Group {
                        Anchor: (Width: 24, Height: 24, Right: 2);
                        Background: $BG.@TrashIcon;

                        TextButton #ClearIngredientsBtn {
                            Text: "";
                            Anchor: (Full: 0);
                        }
                    }
                }

                // ── Ingredient Tree Grid ──
                Group #IngredientTreeContainer {
                    FlexWeight: 1;
                    LayoutMode: TopScrolling;
                    ScrollbarStyle: $C.@DefaultScrollbarStyle;
                }
            }
        }

        } // three-column layout
        } // #Content
    } // $C.@Container
} // Page Root
