// IngredientGroupHeader — Collapsible section header with three-state checkbox
// Server sets: #GroupHeaderLabel.Text, #GroupHeaderIcon.Background,
//              #CheckboxIcon.Background (checkbox state), #ExpandArrow.Background
// Events: #GroupHeaderBtn (expand/collapse), #CheckboxBtn (toggle selection)

$B = "../../../Styles/Buttons.ui";
$L = "../../../Styles/Labels.ui";
$C = "../../../Common.ui";

Group {
    Anchor: (Height: 28, Left: 0, Right: 0);
    Padding: (Left: 4, Right: 4, Top: 2, Bottom: 2);

    Group {
        Anchor: (Full: 0);
        LayoutMode: Left;

        Group {
            Anchor: (Width: 20, Height: 20);
            Padding: (Top: 2, Bottom: 2, Left: 0, Right: 2);
        }

        Group #GroupHeaderIcon {
            Anchor: (Width: 20, Height: 20);
            Padding: (Top: 2, Bottom: 2);
        }

        Group {
            FlexWeight: 1;
            Padding: (Left: 4);

            Label #GroupHeaderLabel {
                Text: "Group Name";
                Anchor: (Full: 0);
                Style: $L.@SectionLabelStyle;
            }
        }

        Group #ExpandArrow {
            Anchor: (Width: 16, Height: 16);
            Padding: (Top: 4, Bottom: 4);
        }
    }

    TextButton #GroupHeaderBtn {
        Text: "";
        Anchor: (Full: 0);
        Style: $B.@TransparentButtonStyle;
    }

    CheckBox #CheckboxIcon {
        Anchor: (Width: 16, Height: 16, Left: 2, Top: 4);
        Background: (TexturePath: "../../../Common/CheckBoxFrame.png", Border: 7);
        Padding: (Full: 2);
        Style: $C.@DefaultCheckBoxStyle;
    }
}