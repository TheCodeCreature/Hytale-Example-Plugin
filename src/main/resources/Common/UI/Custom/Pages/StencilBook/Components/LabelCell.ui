// Reusable grid cell that can render either a recipe tile or a category separator cell.
// Java toggles #RecipeCell/#CategoryCell visibility and sets text/action payloads.

$B = "../../../Styles/Buttons.ui";
$BG = "../../../Styles/Backgrounds.ui";
$L = "../../../Styles/Labels.ui";
$C = "../../../Common.ui";

Group {
    Anchor: (Width: 72, Height: 72);
    Padding: (Left: 0, Right: 0, Top: 0, Bottom: 0);
    Visible: false;

    Group #RecipeCell {
        Anchor: (Full: 0);
        Background: $BG.@ItemSlotFrame;
        Visible: false;

        ItemIcon #Icon {
            Anchor: (Full: 10);
            ShowItemTooltip: true;
        }

        Group #Dim {
            Anchor: (Full: 2);
            Background: $BG.@DimOverlay;
            Visible: false;
        }

        TextButton #Btn {
            Text: "";
            Anchor: (Full: 2);
            Style: $B.@TransparentButtonStyle;
            TooltipText: "";
        }

        Label #RecipeAction {
            Text: "";
            Anchor: (Width: 0, Height: 0);
            Visible: false;
        }
    }

    Group #CategoryCell {
        Anchor: (Full: 0);
        Background: $C.@TertiaryDefaultButtonBackground;
        Padding: (Left: 4, Right: 4, Top: 4, Bottom: 10);
        Visible: false;

        Label #CategoryBtn {
            Text: "";
            Style: $L.@SetGroupLabelStyle;
            Anchor: (Height: 24, Left: 0, Right: 0);
            Padding: (Left: 4, Top: 8, Bottom: 8);
        }
    }
}
