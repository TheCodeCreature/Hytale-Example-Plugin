// Blueprint Bench — single recipe icon cell (static, no drag)
// Group root for background, ItemIcon for display, TextButton overlay for clicks
// Server sets #CellIcon.ItemId and #CellDim.Visible via #RecipeGrid[i]

$B = "../../Styles/Buttons.ui";
$BG = "../../Styles/Backgrounds.ui";

Group {
    Anchor: (Width: 72, Height: 72);
    Padding: (Left: 4, Right: 4, Top: 4, Bottom: 4);
    Group {
        Anchor: (Full: 0);
        Background: $BG.@ItemSlotFrame;

        ItemIcon #CellIcon {
            Anchor: (Full: 4);
            ShowItemTooltip: true;
        }

        // Dimming overlay — toggled via #CellDim.Visible for unaffordable items
        Group #CellDim {
            Anchor: (Full: 2);
            Background: $BG.@DimOverlay;
            Visible: false;
        }

        // Transparent click target — inset to avoid sharp corners
        TextButton #CellBtn {
            Text: "";
            Anchor: (Full: 2);
            Style: $B.@TransparentButtonStyle;
        }
    }
}
