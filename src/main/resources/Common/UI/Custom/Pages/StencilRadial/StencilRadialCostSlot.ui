// Single cost icon slot — positioned absolutely by server
// Non-interactive, display only

$O = "../../Styles/Overlays.ui";
$BG = "../../Styles/Backgrounds.ui";

Group {
    Anchor: (Width: 80, Height: 90);
    Visible: false;
    LayoutMode: Full;

    Group {
        Anchor: (Width: 64, Height: 64, Left: 8, Top: 0);
        Background: $BG.@IconContainerDark;
        ItemIcon #CostIcon {
            Anchor: (Full: 4);
            ShowItemTooltip: false;
        }

        Group #CostDim {
            Anchor: (Full: 2);
            Background: $BG.@DimOverlay;
            Visible: false;
        }

        // Quantity badge — bottom-right of the icon
        Label #CostQty {
            Text: "";
            Anchor: (Width: 32, Height: 14, Left: 32, Top: 49);
            Style: $O.@CostQuantityOverlayStyle;
        }
    }

    Group #CostLabel {
        Anchor: (Width: 80, Height: 24, Left: 0, Top: 65);

        Label #CostName {
            Text: "";
            Anchor: (Full: 0);
            Style: $O.@OverlayCostNameStyle;
        }
    }
}