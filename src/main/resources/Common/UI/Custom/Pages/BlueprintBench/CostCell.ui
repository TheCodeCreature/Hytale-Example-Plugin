// Cost cell — single ingredient icon with quantity overlay
// Reusable component: server appends N instances into #CostGrid during build()
// Server updates via cmd.set() on indexed selectors: #CostGrid[N] #CostIcon, #CostGrid[N] #CostQty
$C = "../../Common.ui";

Group {
    Anchor: (Width: 62, Height: 62);
    Visible: false;
    Padding: (Full: 6);

Group {
    // Padding: (Left: 3, Right: 3, Top: 3, Bottom: 3);
    Background: "../../Common/BlockSelectorSlotBackground.png";
    ItemIcon #CostIcon {
        Anchor: (Full: 2);
        ShowItemTooltip: true;
    }
}

    Label #CostQty {
        Text: "";
        Anchor: (Height: 14, Bottom: 0, Right: 2);
        Style: LabelStyle(
            ...$C.@DefaultLabelStyle,
            FontSize: 11, TextColor: #ffffff,
            HorizontalAlignment: End, VerticalAlignment: End
        );
    }
}
