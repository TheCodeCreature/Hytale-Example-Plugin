// MaterialGroupButton — material group icon button for filter bar

@GroupBtnStyle = TextButtonStyle(
    Default: (Background: #000000(0.0), LabelStyle: (FontSize: 1, TextColor: #000000(0.0))),
    Hovered: (Background: #ffffff(0.1), LabelStyle: (FontSize: 1, TextColor: #000000(0.0))),
    Pressed: (Background: #ffffff(0.2), LabelStyle: (FontSize: 1, TextColor: #000000(0.0)))
);

Group {
    Anchor: (Width: 30, Height: 30);
    Padding: (Left: 1, Right: 1, Top: 1, Bottom: 1);
    Visible: false;
    Background: #141c26;

    ItemIcon #GroupIcon {
        Anchor: (Full: 3);
        Visible: false;
    }

    TextButton #GroupBtn {
        Text: "";
        Anchor: (Full: 0);
        Style: @GroupBtnStyle;
    }
}
