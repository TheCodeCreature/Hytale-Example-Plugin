// MaterialGroupButton — material group icon button for filter bar

$S = "BlueprintBenchStyles.ui";

Group {
    Anchor: (Width: 30, Height: 30);
    Padding: (Left: 1, Right: 1, Top: 1, Bottom: 1);
    Visible: false;
    Background: #141c26;

    ItemIcon #GroupIcon {
        Anchor: (Full: 3);
        Visible: false;
    }

    TextButton #GroupBtn {
        Text: "";
        Anchor: (Full: 0);
        Style: $S.@TransparentButtonStyle;
    }
}
