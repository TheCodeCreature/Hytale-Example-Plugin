// Blueprint Bench — main page layout
// Server appends reusable .ui components (SetFilterButton, CostCell, PlaceholderRow) during build()
// Server updates via cmd.set() only in handleDataEvent() — no append/clear after build()

$C = "../../Common.ui";

// ── Styles ──

@HeaderStyle = LabelStyle(
    ...$C.@DefaultLabelStyle,
    FontSize: 22, RenderBold: true,
    HorizontalAlignment: Start, VerticalAlignment: Center
);

@DetailLabelStyle = LabelStyle(
    ...$C.@DefaultLabelStyle,
    FontSize: 16, RenderBold: true,
    HorizontalAlignment: Start, VerticalAlignment: Center
);

@SubtextStyle = LabelStyle(
    ...$C.@DefaultLabelStyle,
    FontSize: 12, TextColor: #6e7da1,
    HorizontalAlignment: Start, VerticalAlignment: Center
);

@SectionLabelStyle = LabelStyle(
    ...$C.@DefaultLabelStyle,
    FontSize: 13, TextColor: #6e7da1, RenderBold: true,
    HorizontalAlignment: Start, VerticalAlignment: Center
);

@FilterActiveStyle = TextButtonStyle(
    Default: (Background: #2a4a6a, LabelStyle: (FontSize: 11, TextColor: #ffffff,
              HorizontalAlignment: Center, VerticalAlignment: Center)),
    Hovered: (Background: #3a5a7a, LabelStyle: (FontSize: 11, TextColor: #ffffff,
              HorizontalAlignment: Center, VerticalAlignment: Center)),
    Pressed: (Background: #1a3a5a, LabelStyle: (FontSize: 11, TextColor: #ffffff,
              HorizontalAlignment: Center, VerticalAlignment: Center))
);

@FilterInactiveStyle = TextButtonStyle(
    Default: (Background: #141c26(0.0), LabelStyle: (FontSize: 11, TextColor: #6e7da1,
              HorizontalAlignment: Center, VerticalAlignment: Center)),
    Hovered: (Background: #1e2a3a, LabelStyle: (FontSize: 11, TextColor: #96a9be,
              HorizontalAlignment: Center, VerticalAlignment: Center)),
    Pressed: (Background: #1a2535, LabelStyle: (FontSize: 11, TextColor: #96a9be,
              HorizontalAlignment: Center, VerticalAlignment: Center))
);

@SectionHeaderStyle = TextButtonStyle(
    Default: (Background: #141c26(0.0), LabelStyle: (FontSize: 11, TextColor: #6e7da1, RenderBold: true,
              HorizontalAlignment: Start, VerticalAlignment: Center)),
    Hovered: (Background: #1e2a3a, LabelStyle: (FontSize: 11, TextColor: #96a9be, RenderBold: true,
              HorizontalAlignment: Start, VerticalAlignment: Center)),
    Pressed: (Background: #1a2535, LabelStyle: (FontSize: 11, TextColor: #96a9be, RenderBold: true,
              HorizontalAlignment: Start, VerticalAlignment: Center))
);

// ── Page Root ──

Group {
    Anchor: (Width: 1160, Height: 720);
    LayoutMode: Top;

    // Bench tabs above the container
    TabNavigation #BenchTabs {
        Style: $C.@TopTabsStyle;
        SelectedTab: "All";
        Anchor: (Height: 66, Left: 2, Right: 0);

        TabButton {
            Icon: "../../Common/RecipesIcon.png";
            TooltipText: "All";
            Id: "All";
        }

        TabButton {
            Icon: "../../Common/RecipesIcon.png";
            TooltipText: "Builders Bench";
            Id: "Builders";
        }

        TabButton {
            Icon: "../../Common/RecipesIcon.png";
            TooltipText: "Furniture Bench";
            Id: "Furniture_Bench";
        }
    }

    // Main container
    $C.@Container {
    @ContentPadding = 0;
    Anchor: (Left: 50, Width: 1060, Height: 644, Bottom: 10);

    #Title {
        Group {
            LayoutMode: Left;
            Anchor: (Full: 0);

            $C.@Title {
                @Text = "Blueprint Bench:";
            }

            Label #ActiveBenchLabel {
                FlexWeight: 1;
                Anchor: (Left: 0, Top: 4);
                Text: "All";
                Style: (FontSize: 18, TextColor: $C.@ColorDefault, RenderBold: true);
                MaskTexturePath: $C.@TextHighlightGradientMask;
            }



            $C.@HeaderSearch {}
        }
    }

    #Content {

    // Three-column layout
    Group {
        FlexWeight: 1;
        LayoutMode: Left;
        Padding: (Left: 8, Right: 8, Bottom: 8);

    // ══════════════════════════════
    // LEFT COLUMN — Recipe browser
    // ══════════════════════════════
    Group {
        FlexWeight: 1;
        LayoutMode: Top;
        Padding: (Right: 12);

        // Content area: set filters on left, recipe grid on right
        Group {
            FlexWeight: 1;
            LayoutMode: Left;

            // Set filter sidebar — single scrollable column
            Group {
                Anchor: (Width: 164);
                LayoutMode: TopScrolling;
                ScrollbarStyle: $C.@DefaultScrollbarStyle;

                // Filter toggles
                TextButton #AffordableToggle {
                    Text: "Affordable Only";
                    Anchor: (Height: 24, Left: 0, Right: 0);
                    Padding: (Left: 6, Right: 6);
                }

                Group { Anchor: (Height: 2); }

                TextButton #UncategorizedToggle {
                    Text: "Uncategorized";
                    Anchor: (Height: 24, Left: 0, Right: 0);
                    Padding: (Left: 6, Right: 6);
                }

                Group { Anchor: (Height: 6); }

                // Category group icon buttons — collapsible section
                TextButton #CategoriesHeader {
                    Text: "v Categories";
                    Anchor: (Height: 20, Left: 0, Right: 0);
                    Padding: (Left: 6, Right: 6);
                    Style: @SectionHeaderStyle;
                }

                Group #MaterialGroups {
                    LayoutMode: LeftCenterWrap;
                }

                Group { Anchor: (Height: 6); }

                // Set filter buttons — collapsible section
                TextButton #SetsHeader {
                    Text: "v Sets";
                    Anchor: (Height: 20, Left: 0, Right: 0);
                    Padding: (Left: 6, Right: 6);
                    Style: @SectionHeaderStyle;
                }

                Group #SetFilters {
                    LayoutMode: Top;
                }
            }

            // Vertical divider between filters and grid
            Group { Anchor: (Width: 1); Background: #2b3542; }

    // ══════════════════════════════
    // CENTER COLUMN — Recipe browser
    // ══════════════════════════════

            // Scrollable recipe item grid
            Group {
                FlexWeight: 1;
                LayoutMode: TopScrolling;
                ScrollbarStyle: $C.@DefaultScrollbarStyle;
                Padding: (Left: 8);

                Group #RecipeGrid {
                    LayoutMode: LeftCenterWrap;
                }
            }
        }
    }

    // Vertical divider
    Group { Anchor: (Width: 1); Background: #2b3542; }

    // ══════════════════════════════
    // RIGHT COLUMN — Recipe Details
    // ══════════════════════════════
    Group {
        Anchor: (Width: 260);
        LayoutMode: Top;
        Padding: (Left: 12);

        // ── Output Name ──
        Label #OutputName {
            Text: "No recipe selected";
            Style: @DetailLabelStyle;
        }

        Group { Anchor: (Height: 10); }

        // ── Output Icon + Cost Grid ──
        Group {
            Anchor: (Height: 150);
            LayoutMode: Left;

            Group {
                Anchor: (Width: 96, Height: 96, Top: 0);
                Background: "../../Common/BlockSelectorSlotBackground.png";

                ItemIcon #OutputIcon {
                    Anchor: (Full: 4);
                    ShowItemTooltip: true;
                }
            }

            Group { Anchor: (Width: 4); }

            // ── Ingredient cost grid (wrapping, full width) ──
            Group #CostGrid {
                Anchor: (Height: 128, Top: 0);
                LayoutMode: LeftCenterWrap;
                FlexWeight: 1;
            }
        }

        Group { Anchor: (Height: 8); }
        $C.@PanelSeparatorFancy {}
        Group { Anchor: (Height: 8); }

        // ── Placeholder List ──
        Label #InputSlotLabel {
            Text: "Placeholders";
            Anchor: (Height: 20);
            Style: @DetailLabelStyle;
        }

        Group { Anchor: (Height: 4); }

        // Scrollable list of placeholder rows — server appends PlaceholderRow.ui instances during build()
        Group {
            FlexWeight: 1;
            LayoutMode: TopScrolling;
            ScrollbarStyle: $C.@DefaultScrollbarStyle;

            // ── Empty state label (outside PlaceholderList to avoid index offset) ──
            Label #NoPlaceholdersLabel {
                Text: "No placeholders in hotbar";
                Anchor: (Height: 32);
                Visible: false;
                Style: LabelStyle(
                    FontSize: 11, TextColor: #6e7da1,
                    HorizontalAlignment: Center, VerticalAlignment: Center
                );
            }

            Group #PlaceholderList {
                Padding: (Top: 20);
                LayoutMode: Top;
            }
        }

        Group { Anchor: (Height: 4); }
        $C.@PanelSeparatorFancy {}
        Group { Anchor: (Height: 4); }

        // ── Give Stencil Button ──
        $C.@SecondaryTextButton #GetPlaceholderBtn {
            @Text = "Give Stencil";
            Anchor: (Height: 82);
        }
    }

    } // two-column layout
    } // #Content
    } // $C.@Container
} // Page Root
