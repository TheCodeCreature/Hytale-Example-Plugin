// Blueprint Bench — main page layout
// Server populates #RecipeList dynamically via append() calls
// Server populates #PlaceholderSlots with placeholder items from inventory

$C = "../../Common.ui";

// ── Styles ──

@HeaderStyle = LabelStyle(
    ...$C.@DefaultLabelStyle,
    FontSize: 22, RenderBold: true,
    HorizontalAlignment: Start, VerticalAlignment: Center
);

@DetailLabelStyle = LabelStyle(
    ...$C.@DefaultLabelStyle,
    FontSize: 16, RenderBold: true,
    HorizontalAlignment: Start, VerticalAlignment: Center
);

@SubtextStyle = LabelStyle(
    ...$C.@DefaultLabelStyle,
    FontSize: 12, TextColor: #6e7da1,
    HorizontalAlignment: Start, VerticalAlignment: Center
);

@SectionLabelStyle = LabelStyle(
    ...$C.@DefaultLabelStyle,
    FontSize: 13, TextColor: #6e7da1, RenderBold: true,
    HorizontalAlignment: Start, VerticalAlignment: Center
);

@FilterActiveStyle = TextButtonStyle(
    Default: (Background: #2a4a6a, LabelStyle: (FontSize: 11, TextColor: #ffffff,
              HorizontalAlignment: Center, VerticalAlignment: Center)),
    Hovered: (Background: #3a5a7a, LabelStyle: (FontSize: 11, TextColor: #ffffff,
              HorizontalAlignment: Center, VerticalAlignment: Center)),
    Pressed: (Background: #1a3a5a, LabelStyle: (FontSize: 11, TextColor: #ffffff,
              HorizontalAlignment: Center, VerticalAlignment: Center))
);

@FilterInactiveStyle = TextButtonStyle(
    Default: (Background: #141c26(0.0), LabelStyle: (FontSize: 11, TextColor: #6e7da1,
              HorizontalAlignment: Center, VerticalAlignment: Center)),
    Hovered: (Background: #1e2a3a, LabelStyle: (FontSize: 11, TextColor: #96a9be,
              HorizontalAlignment: Center, VerticalAlignment: Center)),
    Pressed: (Background: #1a2535, LabelStyle: (FontSize: 11, TextColor: #96a9be,
              HorizontalAlignment: Center, VerticalAlignment: Center))
);

// ── Page Root ──

Group {
    Anchor: (Width: 1160, Height: 720);
    LayoutMode: Top;

    // Bench tabs above the container
    TabNavigation #BenchTabs {
        Style: $C.@TopTabsStyle;
        SelectedTab: "All";
        Anchor: (Height: 66, Left: 2, Right: 0);

        TabButton {
            Icon: "../../Common/RecipesIcon.png";
            TooltipText: "All";
            Id: "All";
        }

        TabButton {
            Icon: "../../Common/RecipesIcon.png";
            TooltipText: "Builders Bench";
            Id: "Builders";
        }

        TabButton {
            Icon: "../../Common/RecipesIcon.png";
            TooltipText: "Furniture Bench";
            Id: "Furniture_Bench";
        }
    }

    // Main container
    $C.@Container {

    #Title {
        Group {
            LayoutMode: Left;

            Group {
                FlexWeight: 1;
                LayoutMode: Left;
                $C.@Title {
                    @Text = "Blueprint Bench:";
                }

                $C.@Title #ActiveBenchLabel {
                    Text: "All";
                }
            }

            $C.@HeaderSearch {}
        }
    }

    #Content {

    // Two-column layout
    Group {
        FlexWeight: 1;
        LayoutMode: Left;

    // ══════════════════════════════
    // LEFT COLUMN — Recipe browser
    // ══════════════════════════════
    Group {
        FlexWeight: 1;
        LayoutMode: Top;
        Padding: (Right: 12);

        // Content area: set filters on left, recipe grid on right
        Group {
            FlexWeight: 1;
            LayoutMode: Left;

            // Set filter sidebar — single scrollable column
            Group {
                Anchor: (Width: 164);
                LayoutMode: TopScrolling;
                ScrollbarStyle: $C.@DefaultScrollbarStyle;

                // Filter toggles
                TextButton #AffordableToggle {
                    Text: "Affordable Only";
                    Anchor: (Height: 24, Left: 0, Right: 0);
                    Padding: (Left: 6, Right: 6);
                }

                Group { Anchor: (Height: 2); }

                TextButton #UncategorizedToggle {
                    Text: "Uncategorized";
                    Anchor: (Height: 24, Left: 0, Right: 0);
                    Padding: (Left: 6, Right: 6);
                }

                Group { Anchor: (Height: 2); }

                // Set filter buttons (server-populated)
                Group #SetFilters {
                    LayoutMode: Top;
                }
            }

            // Vertical divider between filters and grid
            Group { Anchor: (Width: 1); Background: #2b3542; }

            // Scrollable recipe item grid — ItemGrid for drag support
            Group {
                FlexWeight: 1;
                LayoutMode: TopScrolling;
                ScrollbarStyle: $C.@DefaultScrollbarStyle;
                Padding: (Left: 8);

                ItemGrid #RecipeGrid {
                    FlexWeight: 1;
                    SlotsPerRow: 9;
                    DisplayItemQuantity: false;
                    RenderItemQualityBackground: false;
                    Style: (SlotSize: 64, SlotIconSize: 64, SlotSpacing: 8);
                }
            }
        }
    }

    // Vertical divider
    Group { Anchor: (Width: 1); Background: #2b3542; }

    // ══════════════════════════════
    // RIGHT COLUMN — Recipe Details
    // ══════════════════════════════
    Group {
        Anchor: (Width: 260);
        LayoutMode: Top;
        Padding: (Left: 12);

        // ── Output Name ──
        Label #OutputName {
            Text: "No recipe selected";
            Anchor: (Height: 24);
        }

        // ── Output Icon (centered) ──
        Group {
            Anchor: (Height: 94);
            LayoutMode: Center;

            Group {
                Anchor: (Width: 96, Height: 96);
                FlexWeight: 2;

                ItemIcon #OutputIcon {
                    Anchor: (Full: 4);
                    ShowItemTooltip: true;
                }
            }

            // Ingredient list (server-populated via append)
            Group #CostGrid {
                LayoutMode: LeftCenterWrap;
                FlexWeight: 4;
            }
        }

        Group { Anchor: (Height: 8); }
        $C.@PanelSeparatorFancy {}
        Group { Anchor: (Height: 8); }

        // ── Placeholder Input Slot ──
        Label #InputSlotLabel {
            Text: "Set Placeholder";
            Anchor: (Height: 20);
            Style: @SectionLabelStyle;
        }

        Group { Anchor: (Height: 4); }

        Group {
            Anchor: (Height: 48);
            LayoutMode: Center;

            Group {
                Anchor: (Width: 48, Height: 48);

                Group {
                    Anchor: (Width: 48);
                    LayoutMode: Top;

                    ItemGrid #PlaceholderInputSlot {
                        FlexWeight: 1;
                        SlotsPerRow: 1;
                        DisplayItemQuantity: false;
                        RenderItemQualityBackground: false;
                        Style: (SlotSize: 48, SlotIconSize: 48, SlotSpacing: 0);
                    }
                }

                Group #PlaceholderDropIndicator {
                    Anchor: (Width: 24, Height: 24, Horizontal: 0, Vertical: 0);
                    Background: "../../Common/BlockSelectorSlotDropIcon.png";
                    HitTestVisible: false;
                }
            }
        }

        Group { Anchor: (Height: 4); }

        // Clear button for the placeholder input
        $C.@SecondaryTextButton #ClearPlaceholder {
            Text: "Clear";
            Anchor: (Height: 28);
            Visible: false;
        }
    }

    } // two-column layout
    } // #Content
    } // $C.@Container
} // Page Root
