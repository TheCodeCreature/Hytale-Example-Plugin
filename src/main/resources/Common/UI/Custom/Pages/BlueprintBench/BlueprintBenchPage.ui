// Blueprint Bench — main page layout
// Server appends reusable .ui components (SetFilterButton, CostCell, PlaceholderRow) during build()
// Server updates via cmd.set() only in handleDataEvent() — no append/clear after build()

$C = "../../Common.ui";
$S = "BlueprintBenchStyles.ui";

// ── Page Root ──

Group {
    Anchor: (Width: 1180, Height: 720);
    LayoutMode: Top;

    // Bench tabs above the container
    TabNavigation #BenchTabs {
        Style: $C.@TopTabsStyle;
        SelectedTab: "All";
        Anchor: (Height: 66, Left: 2, Right: 0);

        TabButton {
            Icon: "../../Common/RecipesIcon.png";
            TooltipText: "All";
            Id: "All";
        }

        TabButton {
            Icon: "../../Common/RecipesIcon.png";
            TooltipText: "Builders Bench";
            Id: "Builders";
        }

        TabButton {
            Icon: "../../Common/RecipesIcon.png";
            TooltipText: "Furniture Bench";
            Id: "Furniture_Bench";
        }
    }

    // Main container
    $C.@Container {
        @ContentPadding = (Left: 0, Right: 0, Top: 10, Bottom: 0);
        Anchor: (Width: 1180, Height: 644);

        #Title {
            Group {
                LayoutMode: Left;
                Anchor: (Full: 0);

                $C.@Title {
                    @Text = "Blueprint Bench:";
                }

                Label #ActiveBenchLabel {
                    FlexWeight: 1;
                    Anchor: (Left: 0, Top: 4);
                    Text: "All";
                    Style: (FontSize: 18, TextColor: $C.@ColorDefault, RenderBold: true);
                    MaskTexturePath: $C.@TextHighlightGradientMask;
                }



                $C.@HeaderSearch {}
            }
        }

        #Content {

        // Three-column layout
        Group {
            FlexWeight: 1;
            LayoutMode: Left;
            Padding: (Left: 8, Right: 8, Bottom: 8);

        // ══════════════════════════════
        // LEFT COLUMN — Recipe browser
        // ══════════════════════════════
        Group {
            FlexWeight: 1;
            LayoutMode: Top;
            Padding: (Right: 12);

            // Content area: set filters on left, recipe grid on right
            Group {
                FlexWeight: 1;
                LayoutMode: Left;


                Group {
                    LayoutMode: Top;
                    // Set filter sidebar — single scrollable column
                    Group {
                        Anchor: (Width: 164);
                        LayoutMode: Top;
                        ScrollbarStyle: $C.@DefaultScrollbarStyle;
                        FlexWeight: 1;

                        // Category group icon buttons — collapsible section
                        Group {
                            Anchor: (Height: 30, Left: 0, Right: 0);

                            TextButton #CategoriesHeader {
                                Text: "v Categories";
                                Anchor: (Full: 0);
                                Padding: (Left: 6, Right: 22);
                                Style: $S.@SectionHeaderStyle;
                            }

                            Group {
                                Anchor: (Width: 24, Height: 24, Right: 2);
                                Background: "../../Common/Icons/AssetNotifications/Trash.png";

                                TextButton #ClearCategoriesBtn {
                                    Text: "";
                                    Anchor: (Full: 0);
                                }
                            }
                        }

                        Group {
                            Anchor: (Height: 80);
                            LayoutMode: TopScrolling;
                            ScrollbarStyle: $C.@DefaultScrollbarStyle;

                            Group #MaterialGroups {
                                LayoutMode: LeftCenterWrap;
                            }
                        }

                        Group { Anchor: (Height: 6); }

                        // Set filter buttons — collapsible section
                        Group {
                            Anchor: (Height: 30, Left: 0, Right: 0);

                            TextButton #SetsHeader {
                                Text: "v Sets";
                                Anchor: (Full: 0);
                                Padding: (Left: 6, Right: 22);
                                Style: $S.@SectionHeaderStyle;
                            }

                            Group {
                                Anchor: (Width: 24, Height: 24, Right: 2);
                                Background: "../../Common/Icons/AssetNotifications/Trash.png";

                                TextButton #ClearSetsBtn {
                                    Text: "";
                                    Anchor: (Full: 0);
                                }
                            }
                        }

                        Group #SetFilters {
                            FlexWeight: 1;
                            LayoutMode: TopScrolling;
                            ScrollbarStyle: $C.@DefaultScrollbarStyle;
                        }
                    }
                    // Horizontal divider between
                    Group { Anchor: (Height: 1); Background: #2b3542; }
                    Group { Anchor: (Height: 4); }
                    // Filter toggles
                    TextButton #AffordableToggle {
                        Text: "Inventory Driven";
                        Anchor: (Height: 24, Left: 0, Right: 0);
                        Padding: (Left: 6, Right: 6);
                    }

                    Group { Anchor: (Height: 2); }

                    TextButton #UncategorizedToggle {
                        Text: "Uncategorized";
                        Anchor: (Height: 24, Left: 0, Right: 0);
                        Padding: (Left: 6, Right: 6);
                    }
                }

                // Vertical divider between filters and grid
                Group { Anchor: (Width: 1); Background: #2b3542; }

        // ══════════════════════════════
        // CENTER COLUMN — Recipe browser
        // ══════════════════════════════

                // Scrollable recipe item grid
                Group {
                    FlexWeight: 1;
                    LayoutMode: TopScrolling;
                    ScrollbarStyle: $C.@DefaultScrollbarStyle;
                    Padding: (Left: 8);

                    Group #RecipeGridArea {
                        LayoutMode: Top;
                    }
                }
            }
        }

        // Vertical divider
        Group { Anchor: (Width: 1); Background: #2b3542; }

        // ══════════════════════════════
        // RIGHT COLUMN — Recipe Details
        // ══════════════════════════════
        Group {
            Anchor: (Width: 260);
            LayoutMode: Top;
            Padding: (Left: 12);

            // ── Output Name ──
            Label #OutputName {
                Text: "No recipe selected";
                Style: $S.@DetailLabelStyle;
            }

            Group { Anchor: (Height: 10); }

            // ── Output Icon + Cost Grid ──
            Group {
                Anchor: (Height: 150);
                LayoutMode: LeftScrolling;

                Group {
                    LayoutMode: Top;
                    Group {
                        Anchor: (Height: 96, Width: 96, Top: 0);
                        Background: "../../Common/BlockSelectorSlotBackground.png";

                        ItemIcon #OutputIcon {
                            Anchor: (Full: 4);
                            ShowItemTooltip: true;
                        }
                    }

                    // ── Give Stencil Button ──
                    TextButton #GetPlaceholderBtn {
                        Text: "Give Stencil";
                        Anchor: (Height: 40, Width: 96, Right: 0, Left: 0, Top: 10);
                        Padding: (Left: 12, Right: 12);
                        Style: $S.@WrapSecondaryButtonStyle;
                    }
                }

                Group { Anchor: (Width: 4); }

                // ── Ingredient cost grid (wrapping, full width) ──
                Group #CostGrid {
                    Anchor: (Height: 128, Top: 0);
                    LayoutMode: LeftCenterWrap;
                    FlexWeight: 1;
                }
            }

            Group { Anchor: (Height: 8); }
            $C.@PanelSeparatorFancy {}
            Group { Anchor: (Height: 8); }

            // ── Placeholder List ──
            Label #InputSlotLabel {
                Text: "Placeholders";
                Anchor: (Height: 20);
                Style: $S.@DetailLabelStyle;
            }

            Group { Anchor: (Height: 4); }

            // Scrollable list of placeholder rows — server appends PlaceholderRow.ui instances during build()
            Group {
                FlexWeight: 1;
                LayoutMode: TopScrolling;
                ScrollbarStyle: $C.@DefaultScrollbarStyle;

                // ── Empty state label (outside PlaceholderList to avoid index offset) ──
                Label #NoPlaceholdersLabel {
                    Text: "No placeholders in hotbar";
                    Anchor: (Height: 32);
                    Visible: false;
                    Style: $S.@EmptyStateStyle;
                }

                Group #PlaceholderList {
                    Padding: (Top: 20);
                    LayoutMode: Top;
                }
            }

            Group { Anchor: (Height: 4); }
            $C.@PanelSeparatorFancy {}
        }

        } // two-column layout
        } // #Content
    } // $C.@Container
} // Page Root
