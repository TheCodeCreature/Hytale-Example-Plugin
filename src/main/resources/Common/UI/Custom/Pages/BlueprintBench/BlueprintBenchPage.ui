// Blueprint Bench — main page layout
// Server populates #RecipeList dynamically via append() calls
// Server populates #PlaceholderSlots with placeholder items from inventory

$C = "../../Common.ui";

// ── Styles ──

@HeaderStyle = LabelStyle(
    ...$C.@DefaultLabelStyle,
    FontSize: 22, RenderBold: true,
    HorizontalAlignment: Start, VerticalAlignment: Center
);

@DetailLabelStyle = LabelStyle(
    ...$C.@DefaultLabelStyle,
    FontSize: 16, RenderBold: true,
    HorizontalAlignment: Start, VerticalAlignment: Center
);

@SubtextStyle = LabelStyle(
    ...$C.@DefaultLabelStyle,
    FontSize: 12, TextColor: #6e7da1,
    HorizontalAlignment: Start, VerticalAlignment: Center
);

@SectionLabelStyle = LabelStyle(
    ...$C.@DefaultLabelStyle,
    FontSize: 13, TextColor: #6e7da1, RenderBold: true,
    HorizontalAlignment: Start, VerticalAlignment: Center
);

@SlotLabelStyle = LabelStyle(
    FontSize: 11, TextColor: #96a9be,
    HorizontalAlignment: Center, VerticalAlignment: Center
);

@AssignButtonStyle = TextButtonStyle(
    Default: (Background: #3a7bd5, LabelStyle: (FontSize: 14, TextColor: #ffffff,
              RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
    Hovered: (Background: #4a8be5, LabelStyle: (FontSize: 14, TextColor: #ffffff,
              RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
    Pressed: (Background: #2a6bc5, LabelStyle: (FontSize: 14, TextColor: #ffffff,
              RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

@DisabledAssignStyle = TextButtonStyle(
    Default: (Background: #2b3542, LabelStyle: (FontSize: 14, TextColor: #4a5568,
              RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
    Hovered: (Background: #2b3542, LabelStyle: (FontSize: 14, TextColor: #4a5568,
              RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
    Pressed: (Background: #2b3542, LabelStyle: (FontSize: 14, TextColor: #4a5568,
              RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

@ConfirmButtonStyle = TextButtonStyle(
    Default: (Background: #3a7bd5, LabelStyle: (FontSize: 15, TextColor: #ffffff,
              RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
    Hovered: (Background: #4a8be5, LabelStyle: (FontSize: 15, TextColor: #ffffff,
              RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
    Pressed: (Background: #2a6bc5, LabelStyle: (FontSize: 15, TextColor: #ffffff,
              RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

@DisabledConfirmStyle = TextButtonStyle(
    Default: (Background: #2b3542, LabelStyle: (FontSize: 15, TextColor: #4a5568,
              RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
    Hovered: (Background: #2b3542, LabelStyle: (FontSize: 15, TextColor: #4a5568,
              RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
    Pressed: (Background: #2b3542, LabelStyle: (FontSize: 15, TextColor: #4a5568,
              RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);



@FilterActiveStyle = TextButtonStyle(
    Default: (Background: #2a4a6a, LabelStyle: (FontSize: 11, TextColor: #ffffff,
              HorizontalAlignment: Center, VerticalAlignment: Center)),
    Hovered: (Background: #3a5a7a, LabelStyle: (FontSize: 11, TextColor: #ffffff,
              HorizontalAlignment: Center, VerticalAlignment: Center)),
    Pressed: (Background: #1a3a5a, LabelStyle: (FontSize: 11, TextColor: #ffffff,
              HorizontalAlignment: Center, VerticalAlignment: Center))
);

@FilterInactiveStyle = TextButtonStyle(
    Default: (Background: #141c26(0.0), LabelStyle: (FontSize: 11, TextColor: #6e7da1,
              HorizontalAlignment: Center, VerticalAlignment: Center)),
    Hovered: (Background: #1e2a3a, LabelStyle: (FontSize: 11, TextColor: #96a9be,
              HorizontalAlignment: Center, VerticalAlignment: Center)),
    Pressed: (Background: #1a2535, LabelStyle: (FontSize: 11, TextColor: #96a9be,
              HorizontalAlignment: Center, VerticalAlignment: Center))
);

// ── Page Root ──

Group {
    Anchor: (Width: 1600, Height: 720);
    LayoutMode: Top;

    // Bench tabs above the container
    TabNavigation #BenchTabs {
        Style: $C.@TopTabsStyle;
        SelectedTab: "All";
        Anchor: (Height: 66, Left: 2, Right: 0);

        TabButton {
            Icon: "../../Common/RecipesIcon.png";
            TooltipText: "All";
            Id: "All";
        }

        TabButton {
            Icon: "../../Common/RecipesIcon.png";
            TooltipText: "Builders";
            Id: "Builders";
        }

        TabButton {
            Icon: "../../Common/RecipesIcon.png";
            TooltipText: "Furniture Bench";
            Id: "Furniture_Bench";
        }
    }

    // Main container
    $C.@Container {

    #Title {
        Group {
            LayoutMode: Left;

            Label #Title {
                Text: "Blueprint Bench";
                FlexWeight: 1;
                Style: @HeaderStyle;
            }

            $C.@HeaderSearch {}
        }
    }

    #Content {

    // Two-column layout
    Group {
        FlexWeight: 1;
        LayoutMode: Left;

    // ══════════════════════════════
    // LEFT COLUMN — Recipe browser
    // ══════════════════════════════
    Group {
        FlexWeight: 1;
        LayoutMode: Top;
        Padding: (Right: 12);

        // Content area: set filters on left, recipe grid on right
        Group {
            FlexWeight: 1;
            LayoutMode: Left;

            // Set filter sidebar — single scrollable column
            Group {
                Anchor: (Width: 164);
                LayoutMode: TopScrolling;
                ScrollbarStyle: $C.@DefaultScrollbarStyle;

                // Craftable filter dropdown
                $C.@DropdownBox #CraftableDropdown {
                    @Anchor = (Height: 24, Left: 0, Right: 0);
                    Value: "FULL";

                    DropdownEntry {
                        Value: "NONE";
                        Text: "No Filter";
                    }

                    DropdownEntry {
                        Value: "PARTIAL";
                        Text: "Has Partial";
                    }

                    DropdownEntry {
                        Value: "FULL";
                        Text: "Can Craft";
                    }
                }

                Group { Anchor: (Height: 2); }

                // Set filter buttons (server-populated)
                Group #SetFilters {
                    LayoutMode: Top;
                }
            }

            // Vertical divider between filters and grid
            Group { Anchor: (Width: 1); Background: #2b3542; }

            // Scrollable wrapping recipe icon grid
            Group {
                FlexWeight: 1;
                LayoutMode: TopScrolling;
                ScrollbarStyle: $C.@DefaultScrollbarStyle;
                Padding: (Left: 6);

                Group #RecipeGrid {
                    LayoutMode: LeftCenterWrap;
                }
            }
        }
    }

    // Vertical divider
    Group { Anchor: (Width: 1); Background: #2b3542; }

    // ══════════════════════════════
    // RIGHT COLUMN — Details + Assign
    // ══════════════════════════════
    Group {
        Anchor: (Width: 240);
        LayoutMode: Top;
        Padding: (Left: 12);

        // ── Selected Recipe Preview ──
        Label {
            Text: "SELECTED RECIPE";
            Anchor: (Height: 20);
            Style: @SectionLabelStyle;
        }

        Group { Anchor: (Height: 6); }

        // Preview row: icon + name
        Group {
            Anchor: (Height: 52);
            LayoutMode: Left;

            // Item icon preview
            Group {
                Anchor: (Width: 48, Height: 48);
                Background: #1a2332;

                ItemIcon #OutputIcon {
                    Anchor: (Full: 4);
                }
            }

            Group { Anchor: (Width: 10); }

            // Name
            Group {
                FlexWeight: 1;
                LayoutMode: Top;

                Label #OutputName {
                    Text: "No recipe selected";
                    Anchor: (Height: 22);
                    Style: @DetailLabelStyle;
                }

                Group { FlexWeight: 1; }
            }
        }

        Group { Anchor: (Height: 8); }

        // ── Ingredients ──
        Label {
            Text: "INGREDIENTS";
            Anchor: (Height: 18);
            Style: @SectionLabelStyle;
        }

        Group { Anchor: (Height: 4); }

        // Scrollable ingredient icon grid
        Group {
            LayoutMode: TopScrolling;
            ScrollbarStyle: $C.@DefaultScrollbarStyle;
            FlexWeight: 1;

            Group #CostGrid {
                LayoutMode: LeftCenterWrap;
            }
        }

        Group { Anchor: (Height: 8); }
        $C.@PanelSeparatorFancy {}
        Group { Anchor: (Height: 8); }

        // ── Placeholder Slots ──
        Label {
            Text: "PLACEHOLDER BLOCKS";
            Anchor: (Height: 20);
            Style: @SectionLabelStyle;
        }

        Group { Anchor: (Height: 6); }

        // Container for placeholder slot entries (server appends PlaceholderSlot.ui)
        Group #PlaceholderSlots {
            LayoutMode: Top;
            FlexWeight: 1;
        }

        // ── Status message ──
        Label #StatusMessage {
            Text: "";
            Anchor: (Height: 18);
            Style: @SubtextStyle;
        }

        Group { Anchor: (Height: 8); }
        $C.@PanelSeparatorFancy {}
        Group { Anchor: (Height: 8); }

        // ── Get Placeholder ──
        Label {
            Text: "GET PLACEHOLDER";
            Anchor: (Height: 20);
            Style: @SectionLabelStyle;
        }

        Group { Anchor: (Height: 4); }

        Label #AcquireCostLabel {
            Text: "Cost: 1× Ingredient_Life_Essence";
            Anchor: (Height: 16);
            Style: @SubtextStyle;
        }

        Group { Anchor: (Height: 6); }

        TextButton #AcquireButton {
            Text: "Get Placeholder";
            Anchor: (Height: 36);
            Style: @ConfirmButtonStyle;
        }
    }

    } // two-column layout
    } // #Content
    } // $C.@Container
} // Page Root
