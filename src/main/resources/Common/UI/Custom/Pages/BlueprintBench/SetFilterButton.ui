// SetFilterButton — single set filter toggle button
// Reusable component: server appends N instances into #SetFilters during build()
// Server updates via cmd.set() on indexed selectors: #SetFilters[N].Visible, #Btn.Text, #Btn.Style, #Check.Value

$C = "../../Common.ui";

Group {
    Anchor: (Height: 24);
    Visible: false;

    TextButton #Btn {
        Text: "";
        Anchor: (Full: 0);
        Padding: (Left: 22, Right: 6);
    }

    CheckBox #Check {
        Anchor: (Width: 16, Height: 16, Left: 4, Top: 4);
        Background: (TexturePath: "../../Common/CheckBoxFrame.png", Border: 7);
        Padding: (Full: 2);
        Style: $C.@DefaultCheckBoxStyle;
    }
}
