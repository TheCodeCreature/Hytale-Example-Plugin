// ExactItemFilterButton — exact item filter button using engine ItemIcon
// Server sets: #ItemIconEl.ItemId, #ActiveOverlay.Visible, .Visible
// Events: #ItemBtn (toggle selection)

$S = "BlueprintBenchStyles.ui";

Group {
    Anchor: (Width: 36, Height: 36);
    Padding: (Left: 2, Right: 2, Top: 2, Bottom: 2);
    Visible: false;

    Group {
        Anchor: (Full: 0);
        Background: "../../Common/BlockSelectorSlotBackground.png";

        ItemIcon #ItemIconEl {
            Anchor: (Full: 4);
        }

        Group #ActiveOverlay {
            Anchor: (Full: 0);
            Background: #2a4a6a(0.6);
            Visible: false;
        }

        TextButton #ItemBtn {
            Text: "";
            Anchor: (Full: 0);
            Style: $S.@TransparentButtonStyle;
        }
    }
}
